{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        // Indentation and formatting rules
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.tabSize": 4,

        // File saving and cleanup behavior
        "files.autoSave": "onFocusChange",
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,

        // Syntax associations for Arma files
        "files.associations": {
            "*.cpp": "arma-config",
            "*.hpp": "arma-config",
            "*.inc": "arma-config",
            "*.cfg": "arma-config",
            "*.rvmat": "arma-config"
        }
    },
    "extensions": {
        "recommendations": [
            "editorconfig.editorconfig",
            "Armitxes.sqf",
            "brettmayson.hemtt",
            "DartRuffian.lazyarmadev"
        ]
    }
}
